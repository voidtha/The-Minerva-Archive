function remove()
	local LocalPlayer19 = game:GetService("Players").LocalPlayer

	for _, descendant in pairs(LocalPlayer19:FindFirstChildOfClass("Backpack"):GetDescendants()) do
		if descendant:IsA("Tool") or descendant:IsA("HopperBin") then
			descendant:Destroy()
		end
	end

	for _, descendant in pairs(LocalPlayer19.Character:GetDescendants()) do
		if descendant:IsA("Tool") or descendant:IsA("HopperBin") then
			descendant:Destroy()
		end
	end
end

